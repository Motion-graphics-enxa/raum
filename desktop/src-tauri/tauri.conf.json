{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAUM",
  "version": "0.1.0",
  "identifier": "de.raum.desktop",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["setup"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "RAUM",
    "category": "Productivity",
    "copyright": "Apache-2.0",
    "shortDescription": "RAUM: the private AI interpreter box, in a window",
    "longDescription": "Joins a RAUM interpreter box on your network without a browser. The app shows the box's own web app; it only stores the box address.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-nice",
          "gstreamer1.0-pulseaudio"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["raum"]
      }
    }
  }
}
