<?xml version="1.0" encoding="utf-8"?>
<!-- Address field: 2px rule, 2px corners ("drawings have corners"); focus pen when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <stroke android:width="2dp" android:color="@color/rule_strong" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
