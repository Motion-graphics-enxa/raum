<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light: WebView reports prefers-color-scheme: light. The system bars sit on the Prussian
         band (root view background), so their icons stay light. -->
    <style name="Theme.Raum" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:colorControlActivated">@color/focus</item>
    </style>
</resources>
