# /etc/raum/raum.env (root:raum 0640), read by raum-core, raum-agent and whisper.
# install.sh writes it once and never overwrites it. Template only: do not put secrets in git.

# Which profiles/<name>.yaml the services use. Wins over raum.yaml's `profile:` line, so a
# deploy/push.sh from a laptop whose raum.yaml says `mock` never flips the box.
RAUM_PROFILE=spark
RAUM_HOME=/opt/raum/app

# Alternative box config instead of the repo's raum.yaml (optional):
# RAUM_CONFIG=/etc/raum/raum.yaml

# whisper.service
# WHISPER_DIR=/opt/raum/whisper.cpp
# WHISPER_MODEL=large-v3-turbo
# WHISPER_THREADS=8
