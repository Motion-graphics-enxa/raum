# deploy/.env for docker compose (install.sh writes the real one; never commit it).
RAUM_HOST=192.168.8.10          # the box's LAN IP (DHCP reservation, §8 S0); QR codes use it too
RAUM_NODE_IP=192.168.8.10       # usually the same IP
RAUM_UID=999                    # id -u raum
RAUM_GID=999                    # id -g raum
# RAUM_TS_HOST=spark.tail1234.ts.net   # tailnet certificate variant (Caddyfile, §9.3 A)
# LIVEKIT_IMAGE=livekit/livekit-server:latest
# CADDY_IMAGE=caddy:2
